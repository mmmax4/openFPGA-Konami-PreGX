set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "*pregx_pll7*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_CHANNEL_SPACING "0.0 KHz" -to "*pregx_pll7*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_AUTO_RESET OFF -to "*pregx_pll7*|altera_pll:altera_pll_i*|*"
set_instance_assignment -name PLL_BANDWIDTH_PRESET AUTO -to "*pregx_pll7*|altera_pll:altera_pll_i*|*"
